{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "bun.app.ts",
    "pages",
    "components",
    "data",
    "lib",
    "scripts/*.ts"
  ],
  "exclude": [
    "client"
  ]
}
