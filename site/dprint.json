{
  "typescript": {
    "deno": true
  },
  "json": {
    "deno": true
  },
  "markdown": {
    "deno": true
  },
  "malva": {},
  "excludes": [
    "dist",
    "node_modules",
    "bun.lock",
    "generated",
    ".cache",
    "build"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:dprint-plugin-malva@0.16.0"
  ]
}
