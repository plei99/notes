{
  "name": "notes-site",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "python3 -m venv build/.venv && build/.venv/bin/pip install fonttools brotli",
    "notes": "build/.venv/bin/python build/build.py",
    "build": "rm -rf dist && bun build --app && bun scripts/finish.ts",
    "dev": "bun scripts/serve.ts",
    "check": "dprint check && oxlint && bun check && bun check -p client && bun scripts/check-cjk-coverage.ts",
    "publish": "sh build/publish.sh"
  },
  "dependencies": {
    "react": "0.0.0-experimental-b618bbb4-20261007",
    "react-dom": "0.0.0-experimental-b618bbb4-20261007",
    "react-refresh": "0.0.0-experimental-b618bbb4-20261007",
    "react-server-dom-bun": "0.0.0-experimental-603e6108-20241029"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dprint": "^0.63.0",
    "mathjax-full": "3.2.2",
    "oxlint": "^1.87.0"
  }
}
