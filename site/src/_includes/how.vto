{{# The colophon's "How the notes were converted to HTML": a dialog with a
    flowchart of build/build.py and Lume, in Mermaid. js/how.js draws it when
    the dialog opens, in the theme's colours and the page's font. #}}
{{ set s = site.strings[lang] || site.strings.en }}
<dialog class="how" id="how" aria-labelledby="how-title" closedby="any">
  <header class="how-head">
    <h2 id="how-title">{{ s.how }}</h2>
    <form method="dialog"><button class="how-close" aria-label="{{ s.close }}">×</button></form>
  </header>
  <div class="how-chart" role="img" aria-label="{{ s.how }}"></div>
  <p class="how-failed" hidden>{{ s.how_failed }}</p>
  {{ if lang === "zh" }}
  <script type="text/plain" class="how-source">
flowchart TD
  tex["<b>LaTeX 源文件</b><br>.tex 文件及其宏定义与参考文献"]
  subgraph py ["build.py，逐份笔记运行"]
    find["<b>找出图表</b><br>tikz-cd、TikZ、杨表等"]
    svg["<b>LaTeX + dvisvgm</b><br>每个图表画成 SVG，<br>每种字体搭配各一份"]
    t4ht["<b>tex4ht</b><br>章节、定理、交叉引用、<br>脚注、参考文献"]
    skel["HTML，公式仍为 TeX"]
    mj["<b>MathJax</b><br>TeX → MathML，<br>使用笔记自己的宏"]
    core["<b>mathml_core.py</b><br>MathML → MathML Core，<br>浏览器可直接绘制"]
    tidy["<b>组装与整理</b><br>放回公式和图表，<br>生成目录，复制图片"]
  end
  subgraph site ["Lume，整个网站"]
    page["<b>页面布局</b><br>页眉、字体与主题选择、样式"]
    index["<b>索引</b><br>来自 notes.yaml 目录"]
  end
  pub["<b>GitHub Pages</b><br>由 gh-pages 分支发布"]
  you["<b>你的浏览器</b><br>以你选择的字体将数学排成文字"]
  tex --> find
  find -- "图表" --> svg
  find -- "其余内容，<br>图表以占位符代替" --> t4ht
  t4ht --> skel
  skel -- "每个公式" --> mj --> core --> tidy
  skel -- "其余部分" --> tidy
  svg --> tidy
  tidy -- "HTML 片段" --> page
  page --> pub
  index --> pub
  pub --> you
  </script>
  {{ else }}
  <script type="text/plain" class="how-source">
flowchart TD
  tex["<b>LaTeX source</b><br>the .tex file, its macros and bibliography"]
  subgraph py ["build.py, once per note"]
    find["<b>Find the diagrams</b><br>tikz-cd, TikZ, Young tableaux, …"]
    svg["<b>LaTeX + dvisvgm</b><br>each diagram drawn as an SVG,<br>once per font pairing"]
    t4ht["<b>tex4ht</b><br>sections, theorems, references,<br>footnotes, bibliography"]
    skel["HTML with each formula<br>still in TeX"]
    mj["<b>MathJax</b><br>TeX → MathML,<br>with the note's own macros"]
    core["<b>mathml_core.py</b><br>MathML → MathML Core,<br>which browsers draw natively"]
    tidy["<b>Assemble and tidy</b><br>formulas and diagrams put back,<br>contents built, images copied"]
  end
  subgraph site ["Lume, for the whole site"]
    page["<b>Page layout</b><br>masthead, font and theme pickers, styles"]
    index["<b>Index</b><br>from the notes.yaml catalogue"]
  end
  pub["<b>GitHub Pages</b><br>published from the gh-pages branch"]
  you["<b>Your browser</b><br>sets the maths as text in your chosen font"]
  tex --> find
  find -- "diagrams" --> svg
  find -- "everything else,<br>diagrams as placeholders" --> t4ht
  t4ht --> skel
  skel -- "each formula" --> mj --> core --> tidy
  skel -- "the rest" --> tidy
  svg --> tidy
  tidy -- "HTML fragments" --> page
  page --> pub
  index --> pub
  pub --> you
  </script>
  {{ /if }}
</dialog>
