{
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.2.5/"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "notes": "python3 build/build.py",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "publish": "sh build/publish.sh"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  },
  "fmt": {
    "exclude": ["_site", ".cache", "src/n", "build/node_modules"]
  },
  "lint": {
    "exclude": ["_site", ".cache", "src/n", "build/node_modules"]
  }
}
