{
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.2.5/"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "setup": "python3 -m venv build/.venv && build/.venv/bin/pip install fonttools brotli && cd build && npm install",
    "notes": "build/.venv/bin/python build/build.py",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "publish": "sh build/publish.sh"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  },
  "fmt": {
    "exclude": [
      "_site",
      ".cache",
      "src/n",
      "build/node_modules",
      "build/.venv"
    ]
  },
  "lint": {
    "exclude": [
      "_site",
      ".cache",
      "src/n",
      "build/node_modules",
      "build/.venv"
    ]
  }
}
